# --- Database (Neon Postgres) ---
# Pooled connection (via PgBouncer) - used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (unpooled) connection - used only for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# --- File storage (Vercel Blob) ---
# Auto-populated by Vercel when a Blob store is linked to the project.
# For local dev, get a token from the Vercel dashboard > Storage > Blob.
BLOB_READ_WRITE_TOKEN=""

# --- Auth (Google OAuth) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=/auth/google/callback
SESSION_SECRET=""

# --- App URLs ---
# Only used in dev, where the client (Vite) and server run on different ports.
# In prod, client and API are served from the same Vercel domain (no CORS needed).
CLIENT_URL=http://localhost:5173

# --- Misc ---
SYNC_SECRET=""
GEMINI_API_KEY=""
